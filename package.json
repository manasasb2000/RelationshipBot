{
  "name": "lovestory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "kb:ingest": "DOTENV_CONFIG_PATH=.env.local tsx scripts/ingest/index.ts",
    "kb:eval": "DOTENV_CONFIG_PATH=.env.local EMBEDDING_MODEL=local-hash tsx scripts/eval-rag.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.local tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@ai-sdk/react": "^2.0.0",
    "@auth/drizzle-adapter": "^1.10.0",
    "@google/genai": "^2.23.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.0",
    "ai": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.0",
    "openai": "^7.20.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
