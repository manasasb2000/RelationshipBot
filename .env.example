# Core database and authentication
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=smtps://username:password@smtp.example.com:465
EMAIL_FROM=LoveStory <hello@example.com>

# OpenAI Responses API (generation, structured classification, and web search)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Preferred provider when present
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional OpenAI-compatible fallback provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5

# Embeddings and optional reranker
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# Speech
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# 32-byte key encoded as 64 hexadecimal characters, used for memory encryption
MEMORY_ENCRYPTION_KEY=

# Optional distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
